{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://twinlight.invalid/schemas/evidence-reference.schema.json",
  "type": "object",
  "properties": {
    "message_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "text_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "start": {
      "type": "integer",
      "minimum": 0
    },
    "end": {
      "type": "integer",
      "minimum": 1
    },
    "quote": {
      "type": "string",
      "minLength": 1,
      "maxLength": 6000
    }
  },
  "required": [
    "message_id",
    "text_sha256",
    "start",
    "end",
    "quote"
  ],
  "additionalProperties": false
}
