{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Twinlight explicit visual design v2; separate from personal narrative",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "version": {
      "const": "art-direction-2"
    },
    "persona_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "style": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{2,60}$",
          "description": "Installed versioned style; twinlight-collector is the default. Alternative styles require an explicit current preference."
        },
        "version": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$"
        }
      },
      "required": [
        "id",
        "version"
      ],
      "additionalProperties": false
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "human",
            "animal",
            "anthropomorphic",
            "object"
          ]
        },
        "species": {
          "type": "string",
          "minLength": 2,
          "maxLength": 160
        },
        "gender_presentation": {
          "enum": [
            "male",
            "female",
            "androgynous",
            "unspecified",
            "not_applicable"
          ]
        },
        "age_impression": {
          "type": "string",
          "minLength": 2,
          "maxLength": 160
        },
        "appearance": {
          "type": "array",
          "minItems": 2,
          "maxItems": 5,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "part": {
                "enum": [
                  "hair",
                  "face",
                  "body",
                  "fur",
                  "feathers",
                  "scales",
                  "ears",
                  "eyes",
                  "horns",
                  "surface",
                  "shape",
                  "color"
                ]
              },
              "description": {
                "type": "string",
                "minLength": 2,
                "maxLength": 160
              }
            },
            "required": [
              "part",
              "description"
            ]
          }
        },
        "clothing": {
          "type": "string",
          "minLength": 2,
          "maxLength": 160
        },
        "expression": {
          "type": "string",
          "minLength": 2,
          "maxLength": 160
        },
        "pose": {
          "type": "string",
          "minLength": 2,
          "maxLength": 160
        },
        "main_prop": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "minLength": 2,
              "maxLength": 160
            }
          ]
        },
        "representation": {
          "enum": [
            "original_concept",
            "user_reference"
          ]
        },
        "selection_basis": {
          "type": "string",
          "minLength": 8,
          "maxLength": 300
        }
      },
      "required": [
        "kind",
        "species",
        "gender_presentation",
        "age_impression",
        "appearance",
        "clothing",
        "expression",
        "pose",
        "main_prop",
        "representation",
        "selection_basis"
      ]
    },
    "scene": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "setting": {
          "type": "string",
          "minLength": 2,
          "maxLength": 160
        },
        "lighting": {
          "type": "string",
          "minLength": 2,
          "maxLength": 160
        },
        "composition": {
          "type": "string",
          "minLength": 8,
          "maxLength": 500
        },
        "foreground": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 2,
            "maxLength": 160
          }
        }
      },
      "required": [
        "setting",
        "lighting",
        "composition",
        "foreground"
      ]
    },
    "preferences": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "keep": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "type": "string",
            "minLength": 2,
            "maxLength": 160
          }
        },
        "avoid": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "type": "string",
            "minLength": 2,
            "maxLength": 160
          }
        },
        "basis": {
          "type": "string",
          "minLength": 8,
          "maxLength": 500
        },
        "rejected_asset_sha256": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      },
      "required": [
        "keep",
        "avoid",
        "basis",
        "rejected_asset_sha256"
      ]
    },
    "selection_reason": {
      "type": "string",
      "minLength": 12,
      "maxLength": 500
    },
    "reference_basis": {
      "enum": [
        "text_only",
        "visible_images"
      ]
    },
    "references": {
      "type": "array",
      "maxItems": 5,
      "items": {
        "type": "object",
        "properties": {
          "file": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "required": [
          "file",
          "sha256"
        ],
        "additionalProperties": false
      }
    },
    "reference_consent": {
      "type": "boolean"
    },
    "typography": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "text_color": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$"
        },
        "accent_color": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$"
        },
        "scrim_color": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$"
        },
        "scrim_opacity": {
          "type": "integer",
          "minimum": 0,
          "maximum": 220
        },
        "frame": {
          "enum": [
            "none",
            "single",
            "double"
          ]
        },
        "footer_top": {
          "type": "number",
          "minimum": 0.68,
          "maximum": 0.84
        },
        "layout": {
          "enum": [
            "collector",
            "measured"
          ]
        }
      },
      "required": [
        "text_color",
        "accent_color",
        "scrim_color",
        "scrim_opacity",
        "frame",
        "footer_top"
      ]
    }
  },
  "required": [
    "version",
    "persona_digest",
    "style",
    "subject",
    "scene",
    "preferences",
    "selection_reason",
    "reference_basis",
    "references",
    "reference_consent",
    "typography"
  ]
}
